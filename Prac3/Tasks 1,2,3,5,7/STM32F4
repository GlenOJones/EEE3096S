uint32_t calculate_mandelbrot_float(int width, int height, int max_iterations){
    uint32_t mandelbrot_sum = 0;

    for(int y = 0; y < height; ++y){
        for(int x = 0; x < width; ++x){
            float x_0 = ((float)x / (float)width) * 3.5f - 2.5f;
            float y_0 = ((float)y / (float)height) * 2.0f - 1.0f;
            float x_i = 0.0f, y_i = 0.0f;
            int iteration = 0;

            while((iteration < max_iterations) && (x_i * x_i + y_i * y_i <= 4.0f)){
                float temp = x_i * x_i - y_i * y_i + x_0;
                y_i = 2.0f * x_i * y_i + y_0;
                x_i = temp;
                iteration++;
            }
            mandelbrot_sum += (uint32_t)iteration;
        }
    }
    return mandelbrot_sum;
}

